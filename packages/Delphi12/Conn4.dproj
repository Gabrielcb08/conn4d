<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{C04D0001-4D00-4C00-9000-000000000001}</ProjectGuid>
        <MainSource>Conn4.dpk</MainSource>
        <ProjectVersion>20.2</ProjectVersion>
        <FrameworkType>None</FrameworkType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>1</TargetedPlatforms>
        <AppType>Package</AppType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_UnitSearchPath>..\..\src;..\..\src\Shared;..\..\src\Core\Abstractions;..\..\src\Core\Services;..\..\src\Adapters\FireDAC;..\..\src\Adapters\Zeos;..\..\src\Adapters\UniDAC;..\..\src\Component;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_DcuOutput>.\build\$(Platform)\$(Config)\dcu</DCC_DcuOutput>
        <DCC_BplOutput>..\..\bin</DCC_BplOutput>
        <DCC_DcpOutput>..\..\bin</DCC_DcpOutput>
        <GenDll>true</GenDll>
        <GenPackage>true</GenPackage>
        <RuntimeOnlyPackage>true</RuntimeOnlyPackage>
        <DCC_CBuilderOutput>All</DCC_CBuilderOutput>
        <DCC_E>false</DCC_E>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
        <DCC_Optimize>true</DCC_Optimize>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInformation>2</DCC_DebugInformation>
        <DCC_RangeChecking>true</DCC_RangeChecking>
        <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
        <DCC_AssertionsAtRuntime>true</DCC_AssertionsAtRuntime>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="rtl.dcp"/>
        <DCCReference Include="FireDAC.dcp"/>
        <DCCReference Include="..\..\src\Shared\Conn4D.Shared.Types.pas"/>
        <DCCReference Include="..\..\src\Shared\Conn4D.Shared.Config.pas"/>
        <DCCReference Include="..\..\src\Shared\Conn4D.Shared.Exceptions.pas"/>
        <DCCReference Include="..\..\src\Shared\Conn4D.Shared.Logger.pas"/>
        <DCCReference Include="..\..\src\Core\Abstractions\Conn4D.Core.Base.pas"/>
        <DCCReference Include="..\..\src\Core\Abstractions\Conn4D.Core.Engine.pas"/>
        <DCCReference Include="..\..\src\Core\Abstractions\Conn4D.Core.Pool.pas"/>
        <DCCReference Include="..\..\src\Core\Abstractions\Conn4D.Core.Transaction.pas"/>
        <DCCReference Include="..\..\src\Core\Abstractions\Conn4D.Core.HealthCheck.pas"/>
        <DCCReference Include="..\..\src\Core\Abstractions\Conn4D.Core.Observer.pas"/>
        <DCCReference Include="..\..\src\Core\Abstractions\Conn4D.Core.GC.pas"/>
        <DCCReference Include="..\..\src\Core\Abstractions\Conn4D.Core.Clock.pas"/>
        <DCCReference Include="..\..\src\Core\Abstractions\Conn4D.Core.Monitor.pas"/>
        <DCCReference Include="..\..\src\Core\Abstractions\Conn4D.Core.pas"/>
        <DCCReference Include="..\..\src\Core\Services\Conn4D.Core.Config.pas"/>
        <DCCReference Include="..\..\src\Core\Services\Conn4D.Core.SystemClock.pas"/>
        <DCCReference Include="..\..\src\Core\Services\Conn4D.Core.Semaphore.pas"/>
        <DCCReference Include="..\..\src\Core\Services\Conn4D.Core.ThreadSafeQueue.pas"/>
        <DCCReference Include="..\..\src\Core\Services\Conn4D.Core.ThreadContext.pas"/>
        <DCCReference Include="..\..\src\Core\Services\Conn4D.Core.PoolStore.pas"/>
        <DCCReference Include="..\..\src\Core\Services\Conn4D.Core.ObserverBroadcaster.pas"/>
        <DCCReference Include="..\..\src\Core\Services\Conn4D.Core.Registry.pas"/>
        <DCCReference Include="..\..\src\Core\Services\Conn4D.Core.HealthMonitor.pas"/>
        <DCCReference Include="..\..\src\Core\Services\Conn4D.Core.TransactionMgr.pas"/>
        <DCCReference Include="..\..\src\Core\Services\Conn4D.Core.PoolManager.pas"/>
        <DCCReference Include="..\..\src\Core\Services\Conn4D.Core.Factory.pas"/>
        <DCCReference Include="..\..\src\Core\Services\Conn4D.Core.GarbageCollector.pas"/>
        <DCCReference Include="..\..\src\Adapters\FireDAC\Conn4D.Engine.FireDAC.pas"/>
        <DCCReference Include="..\..\src\Adapters\FireDAC\Conn4D.Adapter.FireDAC.pas"/>
        <DCCReference Include="..\..\src\Adapters\Zeos\Conn4D.Engine.Zeos.pas"/>
        <DCCReference Include="..\..\src\Adapters\Zeos\Conn4D.Adapter.Zeos.pas"/>
        <DCCReference Include="..\..\src\Adapters\UniDAC\Conn4D.Engine.UniDAC.pas"/>
        <DCCReference Include="..\..\src\Adapters\UniDAC\Conn4D.Adapter.UniDAC.pas"/>
        <DCCReference Include="..\..\src\Component\Conn4D.Component.pas"/>
        <DCCReference Include="..\..\src\Conn4D.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Package</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">Conn4.dpk</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">False</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
