<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{485215B1-D70B-45C0-9B9A-E1084AF1CC33}</ProjectGuid>
    <ProjectVersion>20.1</ProjectVersion>
    <FrameworkType>VCL</FrameworkType>
    <MainSource>Conn4D.Tests.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <TargetedPlatforms>1</TargetedPlatforms>
    <AppType>Application</AppType>
    <DCC_DCCCompiler>DCC32</DCC_DCCCompiler>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
    <Cfg_1>true</Cfg_1>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
    <Cfg_2>true</Cfg_2>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <SanitizedProjectName>Conn4DTests</SanitizedProjectName>
    <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Winapi;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UnitSearchPath>..\..\src;..\..\src\01 - Domain;..\..\src\02 - Application Contracts;..\..\src\03 - Application;..\..\src\04 - Infrastructure\FireDAC;..\..\src\05 - Presentation;..\..\modules\DUnitX\Source;Domain;Core;Integration;Support;UI;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_IncludePath>$(DCC_IncludePath)</DCC_IncludePath>
    <DCC_DcuOutput>build\$(Platform)\$(Config)\dcu</DCC_DcuOutput>
    <DCC_ExeOutput>build\$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_E>false</DCC_E>
    <DCC_N>false</DCC_N>
    <DCC_S>false</DCC_S>
    <DCC_F>false</DCC_F>
    <DCC_K>false</DCC_K>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_1)'!=''">
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
    <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
    <DCC_SymbolReferenceInfo>2</DCC_SymbolReferenceInfo>
    <DCC_DebugInformation>2</DCC_DebugInformation>
    <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
    <DCC_RemoteDebug>true</DCC_RemoteDebug>
    <DCC_DebugDCUs>true</DCC_DebugDCUs>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_2)'!=''">
    <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
    <DCC_Optimize>true</DCC_Optimize>
    <DCC_GenerateStackFrames>false</DCC_GenerateStackFrames>
    <DCC_RangeChecking>false</DCC_RangeChecking>
    <DCC_IntegerOverflowCheck>false</DCC_IntegerOverflowCheck>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
    <DCC_DebugInformation>0</DCC_DebugInformation>
    <DCC_DebugDCUs>false</DCC_DebugDCUs>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="Support\Conn4D.Tests.Support.Fakes.pas"/>
    <DCCReference Include="Domain\Conn4D.Tests.Domain.PoolConfig.pas"/>
    <DCCReference Include="Core\Conn4D.Tests.Core.Pool.pas"/>
    <DCCReference Include="Core\Conn4D.Tests.Core.Transaction.pas"/>
    <DCCReference Include="Core\Conn4D.Tests.Core.Handle.pas"/>
    <DCCReference Include="Integration\Conn4D.Tests.Integration.Firebird.pas"/>
    <DCCReference Include="UI\Conn4D.Tests.UI.VisualLogger.pas"/>
    <DCCReference Include="UI\Conn4D.Tests.UI.MainForm.pas">
      <Form>frmTestRunner</Form>
    </DCCReference>
    <BuildConfiguration Include="Release">
      <Key>Cfg_2</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
    </BuildConfiguration>
    <BuildConfiguration Include="Debug">
      <Key>Cfg_1</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
  </ItemGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
  <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType>Application</Borland.ProjectType>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">Conn4D.Tests.dpr</Source>
        </Source>
      </Delphi.Personality>
      <Platforms>
        <Platform value="Win32">True</Platform>
        <Platform value="Win64">False</Platform>
      </Platforms>
    </BorlandProject>
    <ProjectFileVersion>12</ProjectFileVersion>
  </ProjectExtensions>
</Project>
