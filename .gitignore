# ===== Conn4D / Delphi =====

# Configuracoes LOCAIS com dados reais (o *.example.ini SOBE no git)
samples/ConnMonitor/build/settings.ini
**/settings.ini

# Saidas de compilacao de pacotes / apps
packages/**/build/
samples/**/build/
bin/
**/*.bpl
**/*.bpi
**/*.dcp
**/*.dcu
**/*.exe
**/*.lib

# Bibliotecas nativas redistribuiveis dos vendors (Firebird, Borland, etc.).
# NAO redistribua binarios de terceiros pelo repo - o usuario baixa do vendor.
**/*.dll

# Cache do Delphi Language Server (delphilsp): VAZA o layout COMPLETO do disco
# local, usuario do Windows e caminhos de outros projetos. NUNCA versionar.
**/*.delphilsp.json

# Configuracao do Claude Code (caminhos absolutos da maquina + lista de
# permissoes local). As SKILLS em .claude/skills/ continuam versionadas.
.claude/settings.json
.claude/settings.local.json

# Artefatos do compilador / IDE Delphi
*.local
*.identcache
*.tvsconfig
*.skincfg
*.~*
__history/
__recovery/
*.dsk
*.stat
*.map
*.rsm
modules/
boss.lock

# Saidas temporarias dos scripts
_dcu/
out/
